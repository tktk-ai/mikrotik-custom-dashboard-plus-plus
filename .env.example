# Copy to .env and adjust. Everything is optional — without ROUTEROS_HOST the
# dashboard boots straight into its built-in simulated device.

# API / production UI
PORT=8787
HOST=0.0.0.0
DATA_DIR=./data

# Bootstrap a real RouterOS connection on first start
# ROUTEROS_HOST=192.168.88.1
# ROUTEROS_PORT=443
# ROUTEROS_SCHEME=https
# ROUTEROS_USER=dashboard
# ROUTEROS_PASSWORD=CHANGE-ME
# ROUTEROS_NAME=Core router
# ROUTEROS_TLS_VERIFY=false

# Tuning
# ROS_TIMEOUT_MS=15000
# PROBE_TTL_MS=300000
