# Copy to .env and adjust. Everything is optional — without ROUTEROS_HOST the
# dashboard boots straight into its built-in simulated device.

# API / production UI
PORT=8787
# Optional API-key protection when no authenticated reverse proxy is present.
# Required when NODE_ENV=production. Use OIDC/reverse proxy for multi-user deployments.
# DASHBOARD_API_KEY=replace-with-a-long-random-secret
# AUDIT_MAX_BYTES=26214400
HOST=0.0.0.0
DATA_DIR=./data

# Bootstrap a real RouterOS connection on first start
# ROUTEROS_HOST=192.168.88.1
# ROUTEROS_PORT=443
# ROUTEROS_SCHEME=https
# ROUTEROS_USER=dashboard
# ROUTEROS_PASSWORD=CHANGE-ME
# ROUTEROS_NAME=Core router
# ROUTEROS_TLS_VERIFY=true
# ROS_MAX_RESPONSE_BYTES=16777216

# Tuning
# ROS_TIMEOUT_MS=15000
# PROBE_TTL_MS=300000
